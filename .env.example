# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://olfa:olfa@postgres:5432/olfa
REDIS_URL=redis://redis:6379
CORS_ORIGINS=http://localhost:3001

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-01
ADMIN_JWT_SECRET=change-me-change-me-change-me-change-me-02
OTP_HMAC_SECRET=change-me-change-me-change-me-change-me-03
IP_HASH_PEPPER=change-me-pepper-04
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60

# SMS: "log" prints codes to the API log (development only — refused in production)
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Object storage (MinIO locally; S3 / R2 in production)
S3_ENDPOINT=http://minio:9000
S3_REGION=me-central-1
S3_ACCESS_KEY_ID=olfa-local
S3_SECRET_ACCESS_KEY=olfa-local-secret
S3_PRIVATE_BUCKET=olfa-private
S3_PUBLIC_BUCKET=olfa-public
CDN_BASE_URL=http://localhost:9000/olfa-public

# "manual" = every photo goes to human review; "rekognition" adds an automated scan first
MODERATION_PROVIDER=manual

# Firebase service-account JSON (one line) to enable push notifications
FCM_CREDENTIALS_JSON=

# Consultations (web payment for a person-to-person service). Use test keys outside production.
PAYMENT_PROVIDER=test            # stripe | test (test is refused in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Account integrity & counselor payouts ──
# HMAC secret for identifiers of permanently banned accounts (openssl rand -base64 48)
IDENTITY_HMAC_SECRET=
# AES-256-GCM key for payout account details: base64 of 32 random bytes (openssl rand -base64 32)
PAYOUT_ENC_KEY=

# ── Store subscriptions ──
APPLE_BUNDLE_ID=app.olfa
# Apple Root CA - G3 (https://www.apple.com/certificateauthority/AppleRootCA-G3.cer)
APPLE_ROOT_CA_PATH=/run/secrets/AppleRootCA-G3.cer
APPLE_ALLOW_SANDBOX=false
# App Store Server API key (App Store Connect → Users and Access → Integrations); PEM from the secret manager
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_PACKAGE_NAME=app.olfa
# Service-account JSON with access to the Play Developer API (from the secret manager)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Random token appended to the Pub/Sub push URL: /v1/subscriptions/google/rtdn?token=…
GOOGLE_RTDN_TOKEN=
