{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-unit",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/modules/media/image-pipeline.ts",
    "test/unit/**/*.ts"
  ]
}
