enum CounselorKind {
  PSYCHOLOGIST
  FAMILY_COUNSELOR

  @@map("counselor_kind")
}

enum CounselorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("counselor_status")
}

enum ConsultationService {
  PREMARITAL
  MARITAL
  FAMILY
  PARENTING
  INDIVIDUAL
  DIVORCE_RECOVERY

  @@map("consultation_service")
}

enum ConsultationStatus {
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  COMPLETED
  DECLINED
  CANCELLED
  REFUNDED
  EXPIRED

  @@map("consultation_status")
}

enum ConversationKind {
  MATCH
  CONSULTATION

  @@map("conversation_kind")
}

model CounselorProfile {
  userId           String                @id @map("user_id") @db.Uuid
  kind             CounselorKind
  status           CounselorStatus       @default(PENDING)
  displayName      String                @map("display_name") @db.VarChar(60)
  headline         String                @db.VarChar(120)
  bio              String                @db.VarChar(1500)
  yearsExperience  Int                   @map("years_experience") @db.SmallInt
  licenseNumber    String                @map("license_number") @db.VarChar(80)
  licenseAuthority String                @map("license_authority") @db.VarChar(120)
  licenseCountry   String                @map("license_country") @db.Char(2)
  credentialKeys   String[]              @map("credential_keys")
  languages        String[]              @db.Char(2)
  services         ConsultationService[]
  ratingAvg        Decimal               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int                   @default(0) @map("rating_count")
  rejectReason     String?               @map("reject_reason") @db.VarChar(300)
  gender           Gender?
  countryCode      String?               @map("country_code") @db.Char(2)
  city             String?               @db.VarChar(80)
  latitude         Float? // rounded (~1 km), never exposed
  longitude        Float?
  policyVersion    String?               @map("policy_version") @db.VarChar(20)
  policyAcceptedAt DateTime?             @map("policy_accepted_at") @db.Timestamptz
  reviewedBy       String?               @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?             @map("reviewed_at") @db.Timestamptz
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer         AdminUser?            @relation(fields: [reviewedBy], references: [id])
  offerings        CounselorOffering[]
  consultations    Consultation[]
  reviews          ConsultationReview[]
  payoutMethods    PayoutMethod[]
  withdrawals      Withdrawal[]
  walletEntries    WalletEntry[]
  integritySignals CounselorIntegritySignal[]
  integrityCases   CounselorIntegrityCase[]

  @@index([status, kind, ratingAvg(sort: Desc)], map: "counselor_profiles_listing_idx")
  @@map("counselor_profiles")
}

model CounselorOffering {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  counselorId     String              @map("counselor_id") @db.Uuid
  service         ConsultationService
  language        String              @db.Char(2)
  durationMinutes Int                 @map("duration_minutes") @db.SmallInt
  priceMinor      Int                 @map("price_minor")
  currency        String              @db.Char(3)
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  counselor       CounselorProfile    @relation(fields: [counselorId], references: [userId], onDelete: Cascade)
  consultations   Consultation[]

  @@unique([counselorId, service, language, durationMinutes])
  @@map("counselor_offerings")
}

/// State machine and "paid before confirmation" are enforced by the
/// olfa_consultation_guard trigger (see migration 20261114140000).
model Consultation {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String              @map("client_id") @db.Uuid
  counselorId     String              @map("counselor_id") @db.Uuid
  offeringId      String              @map("offering_id") @db.Uuid
  service         ConsultationService
  language        String              @db.Char(2)
  durationMinutes Int                 @map("duration_minutes") @db.SmallInt
  priceMinor      Int                 @map("price_minor")
  currency        String              @db.Char(3)
  status          ConsultationStatus  @default(AWAITING_PAYMENT)
  clientNote      String?             @map("client_note") @db.VarChar(1000)
  preferredTime   DateTime?           @map("preferred_time") @db.Timestamptz
  scheduledAt     DateTime?           @map("scheduled_at") @db.Timestamptz
  declineReason   String?             @map("decline_reason") @db.VarChar(300)
  paymentId       String?             @unique @map("payment_id") @db.Uuid
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz
  paidAt          DateTime?           @map("paid_at") @db.Timestamptz
  confirmedAt     DateTime?           @map("confirmed_at") @db.Timestamptz
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamptz
  /// Commission snapshot taken when the client pays (DB trigger).
  platformFeePercent Int?             @map("platform_fee_percent") @db.SmallInt
  platformFeeMinor   Int?             @map("platform_fee_minor")
  counselorNetMinor  Int?             @map("counselor_net_minor")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  client          User                @relation("ConsultationClient", fields: [clientId], references: [id], onDelete: Cascade)
  counselor       CounselorProfile    @relation(fields: [counselorId], references: [userId])
  offering        CounselorOffering   @relation(fields: [offeringId], references: [id])
  payment         Payment?            @relation("ConsultationPayment", fields: [paymentId], references: [id])
  payments        Payment[]           @relation("ConsultationPayments")
  conversation    Conversation?
  review          ConsultationReview?
  walletEntries   WalletEntry[]
  integritySignals CounselorIntegritySignal[]

  @@index([clientId, createdAt(sort: Desc)], map: "consultations_client_idx")
  @@index([counselorId, status, createdAt(sort: Desc)], map: "consultations_counselor_idx")
  @@map("consultations")
}

model ConsultationReview {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId String           @unique @map("consultation_id") @db.Uuid
  clientId       String           @map("client_id") @db.Uuid
  counselorId    String           @map("counselor_id") @db.Uuid
  rating         Int              @db.SmallInt
  comment        String?          @db.VarChar(1000)
  hidden         Boolean          @default(false)
  /// Mandatory questionnaire (v1). Direct + indirect anti-circumvention answers.
  questionnaireVersion Int?       @map("questionnaire_version") @db.SmallInt
  quality        Int?             @db.SmallInt
  commitment     Int?             @db.SmallInt
  effectiveness  Int?             @db.SmallInt
  outcome        Int?             @db.SmallInt
  nextSession    String?          @map("next_session") @db.VarChar(20)
  nextChannel    String?          @map("next_channel") @db.VarChar(12)
  contactShared  String?          @map("contact_shared") @db.VarChar(6)
  offPlatformPayment String?      @map("off_platform_payment") @db.VarChar(6)
  externalChannel String?         @map("external_channel") @db.VarChar(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  consultation   Consultation     @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  client         User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  counselor      CounselorProfile @relation(fields: [counselorId], references: [userId], onDelete: Cascade)

  @@index([counselorId, createdAt(sort: Desc)], map: "consultation_reviews_counselor_idx")
  @@map("consultation_reviews")
}

