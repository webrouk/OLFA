// OLFA — Prisma schema. Mirrors prisma/migrations/*/migration.sql
// (checked by test/db/check_prisma_vs_db.py). SQL functions olfa_like and
// olfa_consume_quota are called through $queryRaw.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
  RESTRICTED
  DELETED
  BANNED

  @@map("account_status")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED

  @@map("marital_status")
}

enum EducationLevel {
  HIGH_SCHOOL
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE

  @@map("education_level")
}

enum MarriageTimeline {
  WITHIN_6_MONTHS
  WITHIN_1_YEAR
  WITHIN_2_YEARS
  NOT_SURE

  @@map("marriage_timeline")
}

enum AppLocale {
  ar
  en
  fr

  @@map("app_locale")
}

enum PhotoStatus {
  UPLOADING
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("photo_status")
}

enum VerificationType {
  PROFILE_REVIEW
  LIVENESS
  IDENTITY

  @@map("verification_type")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("verification_status")
}

enum DiscoveryAction {
  SHOWN
  LIKED
  PASSED

  @@map("discovery_action")
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
  BLOCKED

  @@map("match_status")
}

enum MessageType {
  TEXT
  SYSTEM
  IMAGE
  VOICE

  @@map("message_type")
}

enum PlanCode {
  FREE
  PLUS
  PREMIUM

  @@map("plan_code")
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  BILLING_RETRY
  CANCELLED
  EXPIRED
  REFUNDED
  REVOKED
  ON_HOLD
  PAUSED
  PENDING

  @@map("subscription_status")
}

enum PaymentProvider {
  APPLE
  GOOGLE
  WEB
  ADMIN_GRANT

  @@map("payment_provider")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum TransactionType {
  CHARGE
  REFUND
  CHARGEBACK
  ADJUSTMENT

  @@map("transaction_type")
}

enum NotificationType {
  NEW_LIKE
  NEW_MATCH
  NEW_MESSAGE
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SUBSCRIPTION
  SYSTEM
  CONSULTATION_REQUEST
  CONSULTATION_CONFIRMED
  CONSULTATION_DECLINED
  CONSULTATION_COMPLETED
  COUNSELOR_APPROVED
  COUNSELOR_REJECTED
  CONVERSATION_EXPIRING
  REMATCH_REQUEST
  REMATCH_ACCEPTED
  NEW_COMPLIMENT
  INTEGRITY_CASE
  WITHDRAWAL_UPDATE
  REVIEW_REQUIRED

  @@map("notification_type")
}

enum ReportTarget {
  USER
  PHOTO
  MESSAGE

  @@map("report_target")
}

enum ReportReason {
  FAKE_PROFILE
  INAPPROPRIATE_PHOTO
  HARASSMENT
  SPAM_SCAM
  UNDERAGE
  NOT_SERIOUS
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTION_TAKEN
  DISMISSED

  @@map("report_status")
}

enum TicketCategory {
  PAYMENT
  ACCOUNT
  VERIFICATION
  TECHNICAL
  OTHER

  @@map("ticket_category")
}

enum TicketStatus {
  OPEN
  PENDING_USER
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum ActorType {
  ADMIN
  USER
  SYSTEM

  @@map("actor_type")
}

enum ModerationActionType {
  APPROVE_PROFILE
  REJECT_PROFILE
  APPROVE_PHOTO
  REJECT_PHOTO
  WARN
  RESTRICT
  SUSPEND
  REACTIVATE
  DISMISS_REPORT
  APPROVE_COUNSELOR
  REJECT_COUNSELOR
  SUSPEND_COUNSELOR
  BAN

  @@map("moderation_action_type")
}

// ───────────────────────── identity & profile ─────────────────────────

model User {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneE164           String        @map("phone_e164") @db.VarChar(16)
  phoneCountry        String        @map("phone_country") @db.Char(2)
  phoneVerifiedAt     DateTime?     @map("phone_verified_at") @db.Timestamptz
  status              AccountStatus @default(PENDING_VERIFICATION)
  locale              AppLocale     @default(en)
  timezone            String        @default("UTC") @db.VarChar(64)
  ageConfirmedAt      DateTime?     @map("age_confirmed_at") @db.Timestamptz
  termsVersion        String?       @map("terms_version") @db.VarChar(20)
  termsAcceptedAt     DateTime?     @map("terms_accepted_at") @db.Timestamptz
  lastActiveAt        DateTime?     @map("last_active_at") @db.Timestamptz
  deletionRequestedAt DateTime?     @map("deletion_requested_at") @db.Timestamptz
  frozenAt            DateTime?     @map("frozen_at") @db.Timestamptz
  freezeReason        String?       @map("freeze_reason") @db.VarChar(40)
  /// Chosen once at sign-up; locked when a profile exists (DB trigger).
  accountType         AccountType?  @map("account_type")
  privacy             UserPrivacySettings?
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  profile              UserProfile?
  preferences          UserPreference?
  interests            UserInterest[]
  photos               UserPhoto[]
  verifications        UserVerification[]
  verificationRequests VerificationRequest[]
  sessions             UserSession[]
  likesSent            Like[]               @relation("LikeFrom")
  likesReceived        Like[]               @relation("LikeTo")
  passesSent           Pass[]               @relation("PassFrom")
  passesReceived       Pass[]               @relation("PassTo")
  matchesA             Match[]              @relation("MatchA")
  matchesB             Match[]              @relation("MatchB")
  matchesEnded         Match[]              @relation("MatchEndedBy")
  scoresAsViewer       CompatibilityScore[] @relation("ScoreViewer")
  scoresAsCandidate    CompatibilityScore[] @relation("ScoreCandidate")
  historyAsViewer      DiscoveryHistory[]   @relation("HistoryViewer")
  historyAsCandidate   DiscoveryHistory[]   @relation("HistoryCandidate")
  conversationsStarted Conversation[]
  memberships          ConversationMember[]
  messages             Message[]
  receipts             MessageReceipt[]
  subscriptions        UserSubscription[]
  usageCounters        UsageCounter[]
  usageEvents          UsageEvent[]
  payments             Payment[]
  purchaseEvents       PurchaseEvent[]
  moderationActions    ModerationAction[]
  reportsFiled         Report[]             @relation("Reporter")
  reportsAgainst       Report[]             @relation("Reported")
  blocksMade           BlockedUser[]        @relation("Blocker")
  blocksReceived       BlockedUser[]        @relation("Blocked")
  tickets              SupportTicket[]
  notifications        Notification[]
  counselorProfile     CounselorProfile?
  consultationsBooked  Consultation[]       @relation("ConsultationClient")
  reviewsWritten       ConsultationReview[]
  rematchRequests      RematchRequest[]

  @@map("users")
}

model UserProfile {
  userId            String           @id @map("user_id") @db.Uuid
  displayName       String           @map("display_name") @db.VarChar(40)
  birthDate         DateTime         @map("birth_date") @db.Date
  gender            Gender
  countryCode       String           @map("country_code") @db.Char(2)
  city              String           @db.VarChar(80)
  showLocation      Boolean          @default(true) @map("show_location")
  maritalStatus     MaritalStatus    @map("marital_status")
  hasChildren       Boolean?         @map("has_children")
  wantsChildren     Boolean?         @map("wants_children")
  education         EducationLevel
  occupation        String           @db.VarChar(60) // key from shared/reference/occupations.tsv
  heightCm          Int?             @map("height_cm") @db.SmallInt // 120–230, optional
  weightKg          Int?             @map("weight_kg") @db.SmallInt // 35–250, optional
  marriageTimeline  MarriageTimeline @map("marriage_timeline")
  smoking           Boolean?
  willingToRelocate Boolean?         @map("willing_to_relocate")
  bio               String           @db.VarChar(500)
  lifestyle         Json             @default("{}")
  completeness      Int              @default(0) @db.SmallInt
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  nationality       String?          @db.Char(2)
  /// Key from shared/reference/religions.tsv; stored only with explicit consent.
  religion          String?          @db.VarChar(30)
  sect              String?          @db.VarChar(40)
  religionConsentAt DateTime?        @map("religion_consent_at") @db.Timestamptz
  latitude          Float? // rounded to 2 decimals (~1 km), never exposed
  longitude         Float?
  locationCountry   String?          @map("location_country") @db.Char(2)
  locationUpdatedAt DateTime?        @map("location_updated_at") @db.Timestamptz
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender, countryCode, birthDate], map: "user_profiles_discovery_idx")
  @@index([locationCountry, latitude, longitude], map: "user_profiles_geo_idx")
  @@map("user_profiles")
}

model Interest {
  id        Int            @id @default(autoincrement())
  key       String         @unique @db.VarChar(40)
  nameAr    String         @map("name_ar") @db.VarChar(60)
  nameEn    String         @map("name_en") @db.VarChar(60)
  category  String         @db.VarChar(40)
  isBasic   Boolean        @default(false) @map("is_basic")
  isActive  Boolean        @default(true) @map("is_active")
  users     UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  interestId Int      @map("interest_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id])

  @@id([userId, interestId])
  @@index([interestId], map: "user_interests_interest_idx")
  @@map("user_interests")
}

model UserPreference {
  userId          String           @id @map("user_id") @db.Uuid
  ageMin          Int              @default(18) @map("age_min") @db.SmallInt
  ageMax          Int              @default(60) @map("age_max") @db.SmallInt
  sameCountryOnly Boolean          @default(false) @map("same_country_only")
  countryCodes    String[]         @default([]) @map("country_codes") @db.Char(2)
  cities          String[]         @default([])
  maritalStatuses MaritalStatus[]  @default([]) @map("marital_statuses")
  educationLevels EducationLevel[] @default([]) @map("education_levels")
  occupations     String[]         @default([])
  wantsChildren   Boolean?         @map("wants_children")
  /// Accepted religions (empty = any) and sects as "religion.sect".
  religions       String[]         @default([]) @db.VarChar(30)
  sects           String[]         @default([]) @db.VarChar(71)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserPhoto {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  storageKey      String      @unique @map("storage_key")
  mimeType        String?     @map("mime_type") @db.VarChar(32)
  bytes           Int?
  width           Int?
  height          Int?
  sha256          String?     @db.Char(64)
  phash           String?     @db.VarChar(32)
  variants        Json        @default("{}")
  position        Int         @db.SmallInt
  status          PhotoStatus @default(UPLOADING)
  rightsConfirmed Boolean     @map("rights_confirmed")
  moderation      Json?
  rejectReason    String?     @map("reject_reason") @db.VarChar(200)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  reviewedAt      DateTime?   @map("reviewed_at") @db.Timestamptz
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_photos")
}

model UserVerification {
  userId     String           @map("user_id") @db.Uuid
  type       VerificationType
  verifiedAt DateTime         @default(now()) @map("verified_at") @db.Timestamptz
  provider   String           @default("olfa-review") @db.VarChar(40)
  reference  String?          @db.VarChar(120)
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("user_verifications")
}

model VerificationRequest {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  type         VerificationType
  status       VerificationStatus @default(PENDING)
  selfieKey    String?            @map("selfie_key")
  autoResult   Json?              @map("auto_result")
  rejectCode   String?            @map("reject_code") @db.VarChar(40)
  rejectReason String?            @map("reject_reason") @db.VarChar(300)
  reviewedBy   String?            @map("reviewed_by") @db.Uuid
  submittedAt  DateTime           @default(now()) @map("submitted_at") @db.Timestamptz
  reviewedAt   DateTime?          @map("reviewed_at") @db.Timestamptz
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer     AdminUser?         @relation(fields: [reviewedBy], references: [id])

  @@index([status, type, submittedAt], map: "verification_requests_queue_idx")
  @@map("verification_requests")
}

// ───────────────────────── discovery & matching ─────────────────────────

model Like {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  compliment String?  @db.VarChar(300) // sent with the like; monthly quota
  from       User     @relation("LikeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("LikeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, createdAt(sort: Desc)], map: "likes_to_idx")
  @@map("likes")
}

model Pass {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  from       User      @relation("PassFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User      @relation("PassTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@map("passes")
}

model Match {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId      String        @map("user_a_id") @db.Uuid
  userBId      String        @map("user_b_id") @db.Uuid
  status       MatchStatus   @default(ACTIVE)
  score        Int?          @db.SmallInt
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  endedAt      DateTime?     @map("ended_at") @db.Timestamptz
  endedBy      String?       @map("ended_by") @db.Uuid
  userA        User          @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User          @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  endedByUser  User?         @relation("MatchEndedBy", fields: [endedBy], references: [id])
  conversation Conversation?

  @@unique([userAId, userBId])
  @@index([userBId], map: "matches_b_idx")
  @@map("matches")
}

model CompatibilityScore {
  viewerId       String   @map("viewer_id") @db.Uuid
  candidateId    String   @map("candidate_id") @db.Uuid
  score          Int      @db.SmallInt
  breakdown      Json
  weightsVersion Int      @map("weights_version")
  computedAt     DateTime @default(now()) @map("computed_at") @db.Timestamptz
  viewer         User     @relation("ScoreViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  candidate      User     @relation("ScoreCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([viewerId, candidateId])
  @@map("compatibility_scores")
}

model DiscoveryHistory {
  id          BigInt          @id @default(autoincrement())
  viewerId    String          @map("viewer_id") @db.Uuid
  candidateId String          @map("candidate_id") @db.Uuid
  action      DiscoveryAction
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  viewer      User            @relation("HistoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  candidate   User            @relation("HistoryCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([viewerId, candidateId, createdAt(sort: Desc)], map: "discovery_history_viewer_idx")
  @@map("discovery_history")
}

// ───────────────────────── messaging ─────────────────────────

model Conversation {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId       String?              @unique @map("match_id") @db.Uuid
  startedBy     String               @map("started_by") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  lastMessageAt DateTime?            @map("last_message_at") @db.Timestamptz
  kind          ConversationKind     @default(MATCH)
  consultationId String?             @unique @map("consultation_id") @db.Uuid
  match         Match?               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  consultation  Consultation?        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  starter       User                 @relation(fields: [startedBy], references: [id])
  members       ConversationMember[]
  messages      Message[]
  rematch       RematchRequest?

  @@index([lastMessageAt(sort: Desc)], map: "conversations_last_idx")
  @@map("conversations")
}

model ConversationMember {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  lastReadAt     DateTime?    @map("last_read_at") @db.Timestamptz
  muted          Boolean      @default(false)
  folder            ConversationFolder @default(INBOX)
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz
  retentionAnchorAt DateTime     @default(now()) @map("retention_anchor_at") @db.Timestamptz
  expiryWarnedAt    DateTime?    @map("expiry_warned_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId], map: "conversation_members_user_idx")
  @@map("conversation_members")
}

model Message {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String           @map("conversation_id") @db.Uuid
  senderId        String           @map("sender_id") @db.Uuid
  clientMessageId String           @map("client_message_id") @db.Uuid
  type            MessageType      @default(TEXT)
  body            String           @default("") @db.VarChar(2000)
  flagged         Boolean          @default(false)
  containsPhone   Boolean          @default(false) @map("contains_phone")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receipts        MessageReceipt[]
  attachments     MessageAttachment[]

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt(sort: Desc)], map: "messages_conv_idx")
  @@map("messages")
}

model MessageReceipt {
  messageId   String    @map("message_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  readAt      DateTime? @map("read_at") @db.Timestamptz
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_receipts")
}

// ───────────────────────── commercial ─────────────────────────

model SubscriptionPlan {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          PlanCode             @unique
  nameAr        String               @map("name_ar") @db.VarChar(40)
  nameEn        String               @map("name_en") @db.VarChar(40)
  isActive      Boolean              @default(true) @map("is_active")
  sortOrder     Int                  @default(0) @map("sort_order") @db.SmallInt
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  entitlements  FeatureEntitlement[]
  products      PlanProduct[]
  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model FeatureEntitlement {
  planId     String           @map("plan_id") @db.Uuid
  featureKey String           @map("feature_key") @db.VarChar(60)
  value      Json
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureKey])
  @@map("feature_entitlements")
}

model PlanProduct {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId       String           @map("plan_id") @db.Uuid
  provider     PaymentProvider
  productId    String           @map("product_id") @db.VarChar(120)
  durationDays Int              @map("duration_days") @db.SmallInt
  isActive     Boolean          @default(true) @map("is_active")
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@unique([provider, productId])
  @@map("plan_products")
}

model UserSubscription {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  planId                String             @map("plan_id") @db.Uuid
  provider              PaymentProvider
  status                SubscriptionStatus
  originalTransactionId String?            @map("original_transaction_id") @db.VarChar(200)
  productId             String?            @map("product_id") @db.VarChar(120)
  startsAt              DateTime           @map("starts_at") @db.Timestamptz
  expiresAt             DateTime           @map("expires_at") @db.Timestamptz
  autoRenew             Boolean            @default(true) @map("auto_renew")
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz
  /// Product that takes over at the next renewal (scheduled downgrade).
  pendingProductId      String?            @map("pending_product_id") @db.VarChar(120)
  graceUntil            DateTime?          @map("grace_until") @db.Timestamptz
  sandbox               Boolean            @default(false)
  replacedBy            String?            @map("replaced_by") @db.Uuid
  lastVerifiedAt        DateTime?          @map("last_verified_at") @db.Timestamptz
  latestTransactionId   String?            @map("latest_transaction_id") @db.VarChar(200)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan   @relation(fields: [planId], references: [id])
