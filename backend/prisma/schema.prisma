  @@map("user_privacy_settings")
}

enum AttachmentKind {
  IMAGE
  VOICE

  @@map("attachment_kind")
}

/// Chat photo (≤3 per message) or voice note (≤60 s). Private bucket only;
/// clients get short-lived signed links.
model MessageAttachment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId      String?        @map("message_id") @db.Uuid
  uploaderId     String         @map("uploader_id") @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  kind           AttachmentKind
  storageKey     String         @unique @map("storage_key") @db.VarChar(200)
  mime           String         @db.VarChar(40)
  bytes          Int
  width          Int?           @db.SmallInt
  height         Int?           @db.SmallInt
  durationMs     Int?           @map("duration_ms")
  waveform       Int[]          @db.SmallInt
  position       Int            @default(0) @db.SmallInt
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  message        Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "message_attachments_message_idx")
  @@map("message_attachments")
}

/// Private objects to delete (filled by a trigger when attachments are removed).
model StorageGarbage {
  storageKey String   @id @map("storage_key") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("storage_garbage")
}

// ───────────── Account types, religion, wallet, integrity (migration 20261114180000) ─────────────

enum AccountType {
  MEMBER
  PSYCHOLOGIST
  FAMILY_COUNSELOR

  @@map("account_type")
}

model Religion {
  key       String  @id @db.VarChar(30)
  nameEn    String  @map("name_en") @db.VarChar(60)
  nameAr    String  @map("name_ar") @db.VarChar(60)
  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  sects     Sect[]

  @@map("religions")
}

model Sect {
  religionKey String   @map("religion_key") @db.VarChar(30)
  key         String   @db.VarChar(40)
  nameEn      String   @map("name_en") @db.VarChar(60)
  nameAr      String   @map("name_ar") @db.VarChar(60)
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  religion    Religion @relation(fields: [religionKey], references: [key])

  @@id([religionKey, key])
  @@map("sects")
}

enum WalletEntryKind {
  EARNING
  EARNING_REVERSAL
  WITHDRAWAL
  WITHDRAWAL_RETURN
  ADJUSTMENT

  @@map("wallet_entry_kind")
}

enum PayoutMethodKind {
  BANK_IBAN
  BANK_SWIFT
  WISE
  PAYPAL
  PAYONEER

  @@map("payout_method_kind")
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
  FAILED
  CANCELLED

  @@map("withdrawal_status")
}

/// Payout destination. Details are sealed (AES-256-GCM); only the mask is readable.
model PayoutMethod {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  counselorId String           @map("counselor_id") @db.Uuid
  kind        PayoutMethodKind
  holderName  String           @map("holder_name") @db.VarChar(120)
  countryCode String           @map("country_code") @db.Char(2)
  currency    String           @db.Char(3)
  detailsEnc  Bytes            @map("details_enc")
  detailsMask String           @map("details_mask") @db.VarChar(60)
  fingerprint String           @db.Char(64)
  isDefault   Boolean          @default(false) @map("is_default")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz
  counselor   CounselorProfile @relation(fields: [counselorId], references: [userId], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@map("payout_methods")
}

/// Ledger debit is written with the request (DB trigger); failures return the funds.
model Withdrawal {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  counselorId    String           @map("counselor_id") @db.Uuid
  payoutMethodId String           @map("payout_method_id") @db.Uuid
  amountMinor    Int              @map("amount_minor")
  currency       String           @db.Char(3)
  status         WithdrawalStatus @default(REQUESTED)
  providerRef    String?          @map("provider_ref") @db.VarChar(120)
  failureReason  String?          @map("failure_reason") @db.VarChar(300)
  processedBy    String?          @map("processed_by") @db.Uuid
  requestedAt    DateTime         @default(now()) @map("requested_at") @db.Timestamptz
  processedAt    DateTime?        @map("processed_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  counselor      CounselorProfile @relation(fields: [counselorId], references: [userId])
  payoutMethod   PayoutMethod     @relation(fields: [payoutMethodId], references: [id])
  entries        WalletEntry[]

  @@map("withdrawals")
}

/// Append-only counselor ledger (earnings net of the platform fee, withdrawals).
model WalletEntry {
  id             BigInt           @id @default(autoincrement())
  counselorId    String           @map("counselor_id") @db.Uuid
  currency       String           @db.Char(3)
  kind           WalletEntryKind
  amountMinor    Int              @map("amount_minor")
  consultationId String?          @map("consultation_id") @db.Uuid
  withdrawalId   String?          @map("withdrawal_id") @db.Uuid
  availableAt    DateTime         @default(now()) @map("available_at") @db.Timestamptz
  memo           String?          @db.VarChar(200)
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  counselor      CounselorProfile @relation(fields: [counselorId], references: [userId])
  consultation   Consultation?    @relation(fields: [consultationId], references: [id])
  withdrawal     Withdrawal?      @relation(fields: [withdrawalId], references: [id])

  @@index([counselorId, currency, createdAt(sort: Desc)], map: "wallet_entries_counselor_idx")
  @@map("wallet_entries")
}

model CounselorIntegritySignal {
  id             BigInt           @id @default(autoincrement())
  counselorId    String           @map("counselor_id") @db.Uuid
  clientId       String?          @map("client_id") @db.Uuid
  consultationId String?          @map("consultation_id") @db.Uuid
  kind           String           @db.VarChar(40)
  weight         Int              @db.SmallInt
  details        Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  counselor      CounselorProfile @relation(fields: [counselorId], references: [userId], onDelete: Cascade)
  consultation   Consultation?    @relation(fields: [consultationId], references: [id])

  @@index([counselorId, createdAt(sort: Desc)], map: "counselor_integrity_signals_idx")
  @@map("counselor_integrity_signals")
}

enum IntegrityCaseStatus {
  OPEN
  AWAITING_RESPONSE
  UNDER_REVIEW
  CLEARED
  WARNED
  SUSPENDED
  BANNED

  @@map("integrity_case_status")
}

/// Human review of a counselor; the counselor is notified and can respond before a decision.
model CounselorIntegrityCase {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  counselorId       String              @map("counselor_id") @db.Uuid
  status            IntegrityCaseStatus @default(OPEN)
  score             Int                 @db.SmallInt
  reasons           String[]            @default([])
  openedAt          DateTime            @default(now()) @map("opened_at") @db.Timestamptz
  notifiedAt        DateTime?           @map("notified_at") @db.Timestamptz
  responseDueAt     DateTime?           @map("response_due_at") @db.Timestamptz
  counselorResponse String?             @map("counselor_response") @db.VarChar(3000)
  respondedAt       DateTime?           @map("responded_at") @db.Timestamptz
  decidedBy         String?             @map("decided_by") @db.Uuid
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz
  decisionReason    String?             @map("decision_reason") @db.VarChar(1000)
  counselor         CounselorProfile    @relation(fields: [counselorId], references: [userId], onDelete: Cascade)
  bans              BannedIdentity[]

  @@map("counselor_integrity_cases")
}

enum BanIdentityKind {
  PHONE
  DEVICE
  LICENSE
  PAYOUT

  @@map("ban_identity_kind")
}

/// HMAC-SHA256 of an identifier of a permanently banned account (re-registration block).
model BannedIdentity {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      BanIdentityKind
  valueHash String                  @map("value_hash") @db.Char(64)
  userId    String?                 @map("user_id") @db.Uuid
  caseId    String?                 @map("case_id") @db.Uuid
  reason    String                  @db.VarChar(300)
  createdBy String?                 @map("created_by") @db.Uuid
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz
  liftedAt  DateTime?               @map("lifted_at") @db.Timestamptz
  liftedBy  String?                 @map("lifted_by") @db.Uuid
  case      CounselorIntegrityCase? @relation(fields: [caseId], references: [id])

  @@map("banned_identities")
}
