<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ per-app language (Settings › Apps › OLFA › Language).
     Copy to android/app/src/main/res/xml/ and reference it from the
     <application android:localeConfig="@xml/locales_config"> element. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ar" />
    <locale android:name="en" />
    <locale android:name="fr" />
</locale-config>
